/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Safe to cache forever because every reference carries a ?v= that is
# bumped whenever these files change — the URL itself is the version.
# Bump the ?v= in ALL html files in the same commit as any assets/ edit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Design prototypes: served (they are part of the repo) but never indexed.
# Page-level noindex lives in each page's <meta name="robots">, which does
# not depend on how Pages matches header rules.
/redesign/*
  X-Robots-Tag: noindex, nofollow
