/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Safe to cache forever because every reference carries a ?v= that is
# bumped whenever these files change — the URL itself is the version.
# Bump the ?v= in ALL html files in the same commit as any assets/ edit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Prototype, reference and repo-housekeeping files: served, but never indexed.
/redesign/*
  X-Robots-Tag: noindex, nofollow
/motion-lab
  X-Robots-Tag: noindex
/motion-lab.html
  X-Robots-Tag: noindex
/tokens
  X-Robots-Tag: noindex
/tokens.html
  X-Robots-Tag: noindex
/README.md
  X-Robots-Tag: noindex
/CONTRIBUTING.md
  X-Robots-Tag: noindex
/CODE_OF_CONDUCT.md
  X-Robots-Tag: noindex
/SECURITY.md
  X-Robots-Tag: noindex
/LICENSE
  X-Robots-Tag: noindex
